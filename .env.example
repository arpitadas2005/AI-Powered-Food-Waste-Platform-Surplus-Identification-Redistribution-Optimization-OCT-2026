# ==============================================================================
# AI-POWERED FOOD WASTE MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the active '.env' file containing real secrets to version control.

# Application Settings
PROJECT_NAME="AI-Powered Food Waste Management Platform"
ENVIRONMENT="development"              # Options: development, staging, production
DEBUG="False"                          # Set to False in production environments

# Security & Authentication (MANDATORY: Change in production!)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Database Configuration
# Local SQLite default (used for evaluation, testing, and single-node demos):
DATABASE_URL="sqlite:///./waste_management.db"
# Production PostgreSQL example (recommended for multi-node deployments):
# DATABASE_URL="postgresql+psycopg://dbuser:StrongPasswordHere@db.example.com:5432/waste_management_prod"

# CORS Configuration (Allowed origins for browser frontend clients)
# Accepts either a JSON list or comma-separated string:
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# Machine Learning Models Directory
MODEL_DIR="./data/models"

# Frontend Environment Configuration (for Vite)
# If frontend is served by FastAPI or reverse proxy, leave empty or '/api/v1'
VITE_API_BASE_URL="/api/v1"
