# Environment Configuration Template
PROJECT_NAME="AI-Powered Food Waste Management Platform"
ENVIRONMENT="development"
DEBUG="True"

# Security (Change in production!)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Database Configuration
# Local SQLite development default:
DATABASE_URL="sqlite:///./waste_management.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/food_waste_db"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
